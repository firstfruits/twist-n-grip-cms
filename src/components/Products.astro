---
interface Product {
  id: number;
  title: string;
  description: string;
  price: string;
  image: string;
}

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<section class="pb-16 bg-white" id="products">
  <div class="max-w-[1240px] mx-auto px-4 md:px-8">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold text-[#1a202c] mb-3">Our Products</h2>
      <p class="text-gray-500 text-sm font-medium">
        Free shipping for orders over $45
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        products.map((product) => (
          <div
            class="bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.06)] hover:shadow-[0_8px_30px_rgb(0,0,0,0.12)] transition-shadow duration-300 overflow-hidden flex flex-col border border-gray-100 product-card"
            data-base-price={product.price}
            data-id={product.id}
            data-title={product.title}
            data-description={product.description}
            data-image={product.image}
          >
            {/* Image Container */}
            <div class="aspect-square w-full flex items-center justify-center bg-[#f2f2f2]">
              <img
                src={product.image}
                alt={product.title}
                class="max-w-full max-h-full w-full object-cover drop-shadow-sm"
                loading="lazy"
              />
            </div>

            {/* Content */}
            <div class="grow flex flex-col p-5">
              <h3 class="text-[15px] font-bold text-[#1a202c] mb-3 leading-snug line-clamp-2">
                {product.title}
              </h3>
              <p class="text-xs text-gray-500 font-light leading-relaxed line-clamp-2">
                {product.description}
              </p>

              {/* Price and Quantity Row */}
              <div class="flex items-center justify-between mb-3 mt-2">
                <span class="text-xl font-bold text-[#1a202c] price-display">
                  ${product.price}
                </span>

                <div class="flex items-center border border-gray-200 rounded-md">
                  <button
                    class="px-3 py-1 text-gray-400 hover:text-gray-600 transition-colors decrease-btn"
                    aria-label="Decrease quantity"
                  >
                    &minus;
                  </button>
                  <input
                    type="text"
                    value="1"
                    class="w-8 text-center text-sm text-[#1a202c] focus:outline-none quantity-input"
                    readonly
                  />
                  <button
                    class="px-3 py-1 text-gray-400 hover:text-gray-600 transition-colors increase-btn"
                    aria-label="Increase quantity"
                  >
                    &#43;
                  </button>
                </div>
              </div>

              {/* Add to Cart Button */}
              <button class="w-full bg-[#C83B2A] hover:bg-[#b03425] text-white font-medium py-2.5 rounded-md flex items-center justify-center gap-2 transition-all duration-200 text-sm shadow-sm group add-to-cart-btn active:scale-95">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-4 h-4"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
                  />
                </svg>
                Add to Cart
              </button>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════════════ -->
<!-- Floating Cart Button                                            -->
<!-- ════════════════════════════════════════════════════════════════ -->
<button
  id="cart-float-btn"
  aria-label="Open cart"
  style="display:none;"
  class="fixed bottom-6 right-6 z-9000  bg-[#C83B2A] hover:bg-[#b03425]  text-white w-14 h-14 rounded-full shadow-[0_10px_30px_rgba(0,0,0,0.25)] flex items-center justify-center hover:bg-[#C83B2A] transition-colors duration-200 group"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="2"
    stroke="currentColor"
    class="w-6 h-6"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
    ></path>
  </svg>
  <span
    id="cart-badge"
    class="absolute -top-1.5 -right-1.5 bg-[#C83B2A] text-white text-[11px] font-bold w-5 h-5 rounded-full flex items-center justify-center shadow-md transition-transform duration-200 scale-0"
    >0</span
  >
</button>

<!-- ════════════════════════════════════════════════════════════════ -->
<!-- Mini-Cart Backdrop                                              -->
<!-- ════════════════════════════════════════════════════════════════ -->
<div
  id="cart-backdrop"
  class="fixed inset-0 z-9001 bg-black/40 backdrop-blur-[2px] opacity-0 pointer-events-none transition-opacity duration-300"
>
</div>

<!-- ════════════════════════════════════════════════════════════════ -->
<!-- Mini-Cart Drawer                                                -->
<!-- ════════════════════════════════════════════════════════════════ -->
<aside
  id="mini-cart"
  class="fixed top-0 right-0 z-9002 h-full w-full max-w-[400px] bg-white shadow-[−8px_0_40px_rgba(0,0,0,0.12)] flex flex-col translate-x-full transition-transform duration-300 ease-in-out"
  aria-label="Shopping cart"
>
  <!-- Drawer Header -->
  <div
    class="flex items-center justify-between px-5 py-4 border-b border-gray-100 bg-[#1a202c]"
  >
    <div class="flex items-center gap-3">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        class="w-5 h-5 text-[#C83B2A]"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
        ></path>
      </svg>
      <h2 class="text-white font-bold text-base tracking-wide">Your Cart</h2>
      <span
        id="cart-count-label"
        class="bg-[#C83B2A] text-white text-[11px] font-bold px-2 py-0.5 rounded-full"
        >0 items</span
      >
    </div>
    <button
      id="close-cart-btn"
      aria-label="Close cart"
      class="text-gray-400 hover:text-white transition-colors p-1 rounded-lg hover:bg-white/10"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        stroke="currentColor"
        class="w-5 h-5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18 18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Cart Items -->
  <div
    id="cart-items-container"
    class="flex-1 overflow-y-auto px-4 py-4 space-y-3"
  >
    <!-- Populated by JS -->
  </div>

  <!-- Empty State -->
  <div
    id="cart-empty-state"
    class="flex-1 flex flex-col items-center justify-center text-center px-8 gap-4"
    style="display:none!important;"
  >
    <div
      class="w-20 h-20 rounded-full bg-gray-100 flex items-center justify-center"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-10 h-10 text-gray-300"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
        ></path>
      </svg>
    </div>
    <div>
      <p class="font-semibold text-[#1a202c] text-base mb-1">
        Your cart is empty
      </p>
      <p class="text-gray-400 text-sm">Add some products to get started!</p>
    </div>
  </div>

  <!-- Drawer Footer -->
  <div
    id="cart-footer"
    class="border-t border-gray-100 px-5 py-4 bg-white"
    style="display:none;"
  >
    <!-- Free Shipping Bar -->
    <div id="shipping-bar-wrap" class="mb-4">
      <div class="flex justify-between text-xs text-gray-500 mb-1.5">
        <span id="shipping-bar-label"
          >Add <strong id="shipping-remaining" class="text-[#C83B2A]"
            >$45.00</strong
          > more for free shipping</span
        >
        <span id="shipping-bar-pct" class="font-medium">0%</span>
      </div>
      <div class="h-1.5 bg-gray-100 rounded-full overflow-hidden">
        <div
          id="shipping-bar-fill"
          class="h-full bg-[#C83B2A] rounded-full transition-all duration-500"
          style="width:0%"
        >
        </div>
      </div>
    </div>

    <!-- Subtotal -->
    <div class="flex items-center justify-between mb-4">
      <span class="text-sm font-medium text-gray-600">Subtotal</span>
      <span id="cart-subtotal" class="text-xl font-bold text-[#1a202c]"
        >$0.00</span
      >
    </div>

    <!-- CTA -->
    <button
      id="checkout-btn"
      class="w-full bg-[#C83B2A] hover:bg-[#b03425] text-white font-bold py-3.5 rounded-xl flex items-center justify-center gap-2 transition-all duration-200 text-sm shadow-md active:scale-95 mb-2"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        stroke="currentColor"
        class="w-4 h-4"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M5 12h14m-7-7 7 7-7 7"></path>
      </svg>
      Proceed to Checkout
    </button>
    <p
      class="text-center text-[11px] text-gray-400 flex items-center justify-center gap-1"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="w-3 h-3"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      </svg>
      Secure checkout powered by Stripe
    </p>
  </div>
</aside>

<!-- ════════════════════════════════════════════════════════════════ -->
<!-- Toast notification                                              -->
<!-- ════════════════════════════════════════════════════════════════ -->
<div
  id="cart-toast"
  class="fixed bottom-24 right-6 z-9100 bg-[#1a202c] text-white text-sm font-medium px-4 py-3 rounded-xl shadow-lg flex items-center gap-2 translate-y-4 opacity-0 pointer-events-none transition-all duration-300"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="2.5"
    stroke="currentColor"
    class="w-4 h-4 text-green-400 shrink-0"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M4.5 12.75l6 6 9-13.5"></path>
  </svg>
  <span id="cart-toast-msg">Added to cart!</span>
</div>

<script>
  // ── Constants ──────────────────────────────────────────────────────────────
  const CART_KEY = "checkout_cart";
  const FREE_SHIPPING_THRESHOLD = 45;

  // ── Helpers ────────────────────────────────────────────────────────────────
  function getCart(): CartItem[] {
    try {
      return JSON.parse(localStorage.getItem(CART_KEY) || "[]");
    } catch {
      return [];
    }
  }

  function saveCart(cart: CartItem[]) {
    localStorage.setItem(CART_KEY, JSON.stringify(cart));
  }

  function cartTotal(cart: CartItem[]): number {
    return cart.reduce(
      (sum, item) => sum + parseFloat(item.price) * item.quantity,
      0,
    );
  }

  function cartItemCount(cart: CartItem[]): number {
    return cart.reduce((sum, item) => sum + item.quantity, 0);
  }

  interface CartItem {
    id: string;
    title: string;
    description: string;
    image: string;
    price: string;
    quantity: number;
  }

  // ── Badge & Count ──────────────────────────────────────────────────────────
  function updateBadge(cart: CartItem[]) {
    const count = cartItemCount(cart);
    const badge = document.getElementById("cart-badge");
    const floatBtn = document.getElementById("cart-float-btn") as HTMLElement;
    const countLabel = document.getElementById("cart-count-label");

    if (badge) {
      badge.textContent = String(count);
      badge.style.transform = count > 0 ? "scale(1)" : "scale(0)";
    }
    if (floatBtn) {
      floatBtn.style.display = count > 0 ? "flex" : "none";
    }
    if (countLabel) {
      countLabel.textContent = count === 1 ? "1 item" : `${count} items`;
    }
  }

  // ── Shipping bar ──────────────────────────────────────────────────────────
  function updateShippingBar(total: number) {
    const pct = Math.min(100, (total / FREE_SHIPPING_THRESHOLD) * 100);
    const remaining = Math.max(0, FREE_SHIPPING_THRESHOLD - total);

    const fill = document.getElementById("shipping-bar-fill");
    const pctEl = document.getElementById("shipping-bar-pct");
    const remainingEl = document.getElementById("shipping-remaining");
    const labelEl = document.getElementById("shipping-bar-label");

    if (fill) fill.style.width = `${pct}%`;
    if (pctEl) pctEl.textContent = `${Math.round(pct)}%`;
    if (remaining <= 0) {
      if (labelEl)
        labelEl.innerHTML = `🎉 <strong>You've unlocked free shipping!</strong>`;
      if (fill) fill.style.backgroundColor = "#16a34a";
    } else {
      if (labelEl)
        labelEl.innerHTML = `Add <strong id="shipping-remaining" class="text-[#C83B2A]">$${remaining.toFixed(2)}</strong> more for free shipping`;
      if (fill) fill.style.backgroundColor = "";
    }
  }

  // ── Render cart items ──────────────────────────────────────────────────────
  function renderCartItems() {
    const cart = getCart();
    const container = document.getElementById("cart-items-container")!;
    const emptyState = document.getElementById(
      "cart-empty-state",
    ) as HTMLElement;
    const footer = document.getElementById("cart-footer") as HTMLElement;

    container.innerHTML = "";

    if (cart.length === 0) {
      emptyState.style.removeProperty("display");
      footer.style.display = "none";
      updateBadge(cart);
      return;
    }

    emptyState.style.setProperty("display", "none", "important");
    footer.style.display = "block";

    cart.forEach((item, index) => {
      const lineTotal = (parseFloat(item.price) * item.quantity).toFixed(2);
      const div = document.createElement("div");
      div.className =
        "flex gap-3 bg-white border border-gray-100 rounded-xl p-3 shadow-sm hover:shadow-md transition-shadow duration-200";
      div.innerHTML = `
        <div class="w-16 h-16 shrink-0 bg-[#f2f2f2] rounded-lg overflow-hidden flex items-center justify-center">
          <img src="${item.image}" alt="${item.title}" class="w-full h-full object-cover" />
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex justify-between items-start gap-1 mb-1.5">
            <p class="text-[13px] font-semibold text-[#1a202c] leading-tight line-clamp-2 flex-1">${item.title}</p>
            <button data-index="${index}" class="cart-remove-btn shrink-0 text-gray-300 hover:text-[#C83B2A] transition-colors p-0.5 ml-1" aria-label="Remove item">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 pointer-events-none">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center border border-gray-200 rounded-lg overflow-hidden">
              <button data-index="${index}" class="cart-dec-btn px-2 py-1 text-gray-400 hover:text-[#C83B2A] hover:bg-gray-50 transition-colors text-sm font-bold" aria-label="Decrease">−</button>
              <span class="px-2.5 py-1 text-sm font-semibold text-[#1a202c] border-x border-gray-200 min-w-[2rem] text-center">${item.quantity}</span>
              <button data-index="${index}" class="cart-inc-btn px-2 py-1 text-gray-400 hover:text-[#C83B2A] hover:bg-gray-50 transition-colors text-sm font-bold" aria-label="Increase">+</button>
            </div>
            <span class="text-sm font-bold text-[#C83B2A]">$${lineTotal}</span>
          </div>
        </div>
      `;
      container.appendChild(div);
    });

    // Bind item controls
    container.querySelectorAll(".cart-remove-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.index!);
        const cart = getCart();
        cart.splice(idx, 1);
        saveCart(cart);
        renderCartItems();
        updateBadge(cart);
      });
    });

    container.querySelectorAll(".cart-dec-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.index!);
        const cart = getCart();
        if (cart[idx].quantity > 1) {
          cart[idx].quantity--;
        } else {
          cart.splice(idx, 1);
        }
        saveCart(cart);
        renderCartItems();
        updateBadge(cart);
      });
    });

    container.querySelectorAll(".cart-inc-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.index!);
        const cart = getCart();
        cart[idx].quantity++;
        saveCart(cart);
        renderCartItems();
        updateBadge(cart);
      });
    });

    // Subtotal & shipping
    const total = cartTotal(cart);
    const subtotalEl = document.getElementById("cart-subtotal");
    if (subtotalEl) subtotalEl.textContent = `$${total.toFixed(2)}`;
    updateShippingBar(total);
    updateBadge(cart);
  }

  // ── Toast ──────────────────────────────────────────────────────────────────
  function showCartToast(message: string) {
    const toast = document.getElementById("cart-toast");
    const msg = document.getElementById("cart-toast-msg");
    if (!toast || !msg) return;
    msg.textContent = message;
    toast.style.opacity = "1";
    toast.style.transform = "translateY(0)";
    toast.style.pointerEvents = "auto";
    setTimeout(() => {
      toast.style.opacity = "0";
      toast.style.transform = "translateY(0.25rem)";
      toast.style.pointerEvents = "none";
    }, 2500);
  }

  // ── Drawer open/close ──────────────────────────────────────────────────────
  function openCart() {
    const drawer = document.getElementById("mini-cart");
    const backdrop = document.getElementById("cart-backdrop");
    renderCartItems();
    drawer?.classList.remove("translate-x-full");
    if (backdrop) {
      backdrop.style.opacity = "1";
      backdrop.style.pointerEvents = "auto";
    }
    document.body.style.overflow = "hidden";
  }

  function closeCart() {
    const drawer = document.getElementById("mini-cart");
    const backdrop = document.getElementById("cart-backdrop");
    drawer?.classList.add("translate-x-full");
    if (backdrop) {
      backdrop.style.opacity = "0";
      backdrop.style.pointerEvents = "none";
    }
    document.body.style.overflow = "";
  }

  // ── Boot ───────────────────────────────────────────────────────────────────
  document.addEventListener("DOMContentLoaded", () => {
    // Initialize badge from stored cart
    updateBadge(getCart());

    // Product cards — Add to Cart
    document.querySelectorAll<HTMLElement>(".product-card").forEach((card) => {
      const basePrice = parseFloat(card.getAttribute("data-base-price")!);
      const id = card.getAttribute("data-id")!;
      const title = card.getAttribute("data-title")!;
      const description = card.getAttribute("data-description")!;
      const image = card.getAttribute("data-image")!;

      const decreaseBtn =
        card.querySelector<HTMLButtonElement>(".decrease-btn")!;
      const increaseBtn =
        card.querySelector<HTMLButtonElement>(".increase-btn")!;
      const quantityInput =
        card.querySelector<HTMLInputElement>(".quantity-input")!;
      const priceDisplay =
        card.querySelector<HTMLSpanElement>(".price-display")!;
      const addToCartBtn =
        card.querySelector<HTMLButtonElement>(".add-to-cart-btn")!;

      let quantity = 1;

      const updatePrice = () => {
        priceDisplay.textContent = `$${(basePrice * quantity).toFixed(2)}`;
      };

      decreaseBtn.addEventListener("click", () => {
        if (quantity > 1) {
          quantity--;
          quantityInput.value = String(quantity);
          updatePrice();
        }
      });

      increaseBtn.addEventListener("click", () => {
        quantity++;
        quantityInput.value = String(quantity);
        updatePrice();
      });

      addToCartBtn.addEventListener("click", () => {
        const cart = getCart();
        const existing = cart.find((i) => i.id === id);
        if (existing) {
          existing.quantity += quantity;
        } else {
          cart.push({
            id,
            title,
            description,
            image,
            price: String(basePrice),
            quantity,
          });
        }
        saveCart(cart);
        updateBadge(cart);

        // Reset card to qty 1
        quantity = 1;
        quantityInput.value = "1";
        updatePrice();

        showCartToast(`"${title}" added to cart!`);
        openCart();
      });
    });

    // Float button
    document
      .getElementById("cart-float-btn")
      ?.addEventListener("click", openCart);

    // Close button
    document
      .getElementById("close-cart-btn")
      ?.addEventListener("click", closeCart);

    // Backdrop click
    document
      .getElementById("cart-backdrop")
      ?.addEventListener("click", closeCart);

    // Checkout button
    document.getElementById("checkout-btn")?.addEventListener("click", () => {
      const cart = getCart();
      if (cart.length === 0) return;
      closeCart();
      window.location.href = "/checkout";
    });

    // ESC key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeCart();
    });
  });
</script>
